# Laravel public ORIGIN only — no /api or /api/v1 suffix.
# Never put secrets, DB credentials, or private API keys in EXPO_PUBLIC_* vars.
#
# Examples (adjust path to your XAMPP document root):
#   Android emulator → host:  http://10.0.2.2/tazen_web/public_html/public
#   iOS simulator:            http://localhost/tazen_web/public_html/public
#   Physical device (LAN):    http://192.168.x.x/tazen_web/public_html/public
#
# Phase 1 APIs:
#   Public availability: {ORIGIN}/api/professional/{id}/...
#   Sanctum auth:        {ORIGIN}/api/v1/auth/...  and  {ORIGIN}/api/v1/me
EXPO_PUBLIC_API_BASE_URL=
